# ==============================================================================
# TraceFlow SCM — Plantilla de Entorno para Certificación PostgreSQL Real (MI-03)
# Archivo: backend/.env.cert.example (SIN SECRETOS)
# Uso: Definir estas variables en la sesión local de consola o en backend/.env.cert
# ==============================================================================

TEST_DB_HOST=127.0.0.1
TEST_DB_PORT=5432
TEST_DB_ADMIN_USER=postgres
TEST_DB_ADMIN_PASSWORD=<PASSWORD_ADMIN_POSTGRES_LOCAL>
TEST_DB_NAME=traceflow_cert
TEST_DB_APP_USER=traceflow_app
TEST_DB_APP_PASSWORD=<PASSWORD_APP_CERT_LOCAL>

# Destino exclusivo para pruebas destructivas aisladas (solo traceflow_cert)
TEST_DATABASE_URL=postgresql://traceflow_app:<PASSWORD_APP_CERT_LOCAL>@127.0.0.1:5432/traceflow_cert
ALLOW_REMOTE_TEST_DML=false
