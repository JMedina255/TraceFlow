# ==============================================================================
# TraceFlow SCM — Variables de Entorno del Backend NestJS (Ejemplo sin Secretos)
# Archivo: backend/.env.example
# ==============================================================================

# Entorno y Puerto
NODE_ENV=development
PORT=3001

# Orígenes Permitidos para CORS (Frontend SPA)
CORS_ORIGIN=http://localhost:5173

# Modo de Base de Datos ('postgres' para Supabase real, 'mock' para pruebas unitarias desconectadas)
DATABASE_MODE=postgres

# Base de Datos PostgreSQL — Supabase Session Pooler (IPv4) o Conexión Directa
# Formato Pooler: postgresql://[user].[project_ref]:[password]@aws-0-us-west-2.pooler.supabase.com:5432/postgres
# Formato Directo: postgresql://[user]:[password]@db.xmyfqxlvveiawnxgydtz.supabase.co:5432/postgres
# NOTA: En desarrollo/operativo utilizar el usuario de aplicación 'traceflow_app' de mínimo privilegio
DATABASE_URL=postgresql://traceflow_app.xmyfqxlvveiawnxgydtz:TU_PASSWORD_AQUI@aws-0-us-west-2.pooler.supabase.com:5432/postgres

# Validación Criptográfica TLS con Certificado CA Público de Supabase (Sin rejectUnauthorized: false)
DATABASE_SSL=true
DATABASE_SSL_REJECT_UNAUTHORIZED=true
DATABASE_SSL_CA_PATH=./cert/prod-ca-2021.crt

# Seguridad de Sesión (ADR-006)
SESSION_COOKIE_SECURE=false
SESSION_COOKIE_SAME_SITE=lax
SESSION_TTL_MINUTES=15
