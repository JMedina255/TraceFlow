# ==============================================================================
# TraceFlow SCM — Variables de Entorno del Backend NestJS (Ejemplo sin Secretos)
# Archivo: backend/.env.example
# ==============================================================================

# Entorno y Puerto
NODE_ENV=development
PORT=3001

# Orígenes Permitidos para CORS (Frontend SPA)
CORS_ORIGIN=http://localhost:5173

# Base de Datos PostgreSQL (Privada, conexión directa en backend)
# Formato: postgresql://[user]:[password]@[host]:[port]/[database]?sslmode=require
DATABASE_URL=postgresql://postgres.sample:SamplePassword123@db.supabase.co:5432/postgres

# Seguridad de Sesión (ADR-006)
# En desarrollo local http, cambiar a false; en producción HTTPS obligatorio true
SESSION_COOKIE_SECURE=false
SESSION_COOKIE_SAME_SITE=lax
SESSION_TTL_MINUTES=15
