{
  "name": "traceflow-backend",
  "version": "1.0.0",
  "description": "TraceFlow SCM — Backend NestJS Monolito Modular (ADR-003, ADR-006, ADR-008)",
  "private": true,
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "node dist/main.js",
    "start:dev": "tsx watch src/main.ts",
    "lint": "tsc --noEmit",
    "provision:users": "tsx src/scripts/provision-users.ts",
    "provision:demo": "tsx src/scripts/provision-demo.ts",
    "test": "vitest run",
    "test:unit": "vitest run test/auth.spec.ts test/organizations.spec.ts test/projects.spec.ts test/projects-h02.spec.ts test/rfcs.spec.ts test/governance-negative.spec.ts test/migration-compatibility.spec.ts test/vertical-flow.e2e-spec.ts test/destructive-safeguards.spec.ts",
    "test:pgmem": "vitest run test/isolated-pgmem-tests.spec.ts",
    "test:real-postgres": "tsx test/scripts/run-real-postgres.ts",
    "test:supabase": "tsx test/scripts/run-supabase-tests.ts",
    "test:all": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "vitest run --config vitest.config.e2e.ts"
  },
  "dependencies": {
    "@nestjs/common": "^11.0.10",
    "@nestjs/core": "^11.0.10",
    "@nestjs/platform-express": "^11.0.10",
    "@node-rs/argon2": "^2.2.2",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "cookie-parser": "^1.4.7",
    "dotenv": "^16.4.7",
    "pg": "^8.13.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.8",
    "@types/express": "^5.0.0",
    "@types/node": "^22.13.5",
    "@types/pg": "^8.11.11",
    "@types/supertest": "^6.0.2",
    "pg-mem": "^3.0.14",
    "supertest": "^7.0.0",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3",
    "vitest": "^3.0.6"
  }
}
